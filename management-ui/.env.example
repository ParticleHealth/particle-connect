# Particle Health Management API credentials
# Get these from your Particle Health representative.
# Sandbox and production use separate org service accounts.
PARTICLE_SANDBOX_CLIENT_ID=your-sandbox-client-id-here
PARTICLE_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret-here

PARTICLE_PROD_CLIENT_ID=your-prod-client-id-here
PARTICLE_PROD_CLIENT_SECRET=your-prod-client-secret-here

# Active environment: "sandbox" or "production" (default: sandbox)
PARTICLE_ENV=sandbox

# Optional overrides
# PARTICLE_TIMEOUT=30
